{
  "name": "s3-upload-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "PROFILE=mock tsx src/server.ts",
    "start:mock": "PROFILE=mock tsx src/server.ts",
    "start:localstack": "PROFILE=localstack tsx src/server.ts",
    "start:aws": "PROFILE=aws tsx src/server.ts",
    "dev": "PROFILE=mock nodemon --exec tsx src/server.ts",
    "dev:mock": "PROFILE=mock nodemon --exec tsx src/server.ts",
    "dev:localstack": "PROFILE=localstack nodemon --exec tsx src/server.ts",
    "dev:aws": "PROFILE=aws nodemon --exec tsx src/server.ts",
    "localstack": "docker compose up -d",
    "postgres": "docker compose up -d postgres",
    "workflow:mock": "PROFILE=mock tsx src/runWorkflow.ts",
    "workflow:localstack": "PROFILE=localstack tsx src/runWorkflow.ts",
    "workflow:aws": "PROFILE=aws tsx src/runWorkflow.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1134.0",
    "@aws-sdk/client-rekognition": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/credential-providers": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
