PORT=3001
PROFILE=mock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=local-uploads
# PROFILE=aws uses real Rekognition CompareFaces.
# Replace test keys above, or leave them as test and use ~/.aws/credentials / AWS_PROFILE.
# Optional: real S3 bucket for uploads. If unset, files stay local and bytes go to Rekognition.
# AWS_S3_BUCKET=your-real-uploads-bucket
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=upload_app
